# eBay credentials — use EITHER option A or option B:

# OPTION A (easiest): Pre-generated token from the eBay developer portal
# Go to developer.ebay.com/my/keys → click your app → User Tokens tab → Get OAuth Application Token
# Copy the token and paste it here. Valid for 2 hours — refresh it before each crawl run.
EBAY_ACCESS_TOKEN=

# OPTION B: Client credentials (auto-refreshes tokens)
# Requires your Cert ID — found on developer.ebay.com/my/keys
EBAY_CLIENT_ID=your_ebay_client_id_here
EBAY_CLIENT_SECRET=your_ebay_client_secret_here

# Email sending (for outreach)
# Use Gmail with an App Password (not your main password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=Adrian Simpson <your@gmail.com>

# Dashboard
PORT=3456
